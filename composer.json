{
    "name": "nowo-tech/beacon-php",
    "description": "Framework-free PHP client for Beacon (nowo error tracking): DSN, Envelope ingest over PSR-18 or Symfony HttpClient, scope and breadcrumbs, scrubbing, error / exception / fatal handlers, Monolog handler.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "beacon",
        "error-tracking",
        "monitoring",
        "envelope",
        "psr-18",
        "monolog",
        "frankenphp",
        "nowo"
    ],
    "homepage": "https://github.com/nowo-tech/beacon-php",
    "support": {
        "issues": "https://github.com/nowo-tech/beacon-php/issues",
        "source": "https://github.com/nowo-tech/beacon-php",
        "docs": "https://github.com/nowo-tech/beacon-php/tree/main/docs",
        "changelog": "https://github.com/nowo-tech/beacon-php/blob/main/docs/CHANGELOG.md",
        "security": "https://github.com/nowo-tech/beacon-php/security/policy"
    },
    "authors": [
        {
            "name": "Héctor Franco Aceituno",
            "email": "hectorfranco@nowo.tech",
            "homepage": "https://github.com/HecFranco",
            "role": "Developer"
        },
        {
            "name": "Nowo.tech",
            "homepage": "https://nowo.tech"
        }
    ],
    "require": {
        "php": ">=8.2 <8.6",
        "ext-json": "*",
        "psr/clock": "^1.0",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0",
        "psr/http-message": "^1.1 || ^2.0",
        "psr/log": "^1.0 || ^2.0 || ^3.0",
        "symfony/polyfill-mbstring": "^1.31"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.64",
        "guzzlehttp/guzzle": "^7.9",
        "monolog/monolog": "^3.0",
        "nyholm/psr7": "^1.8",
        "php-http/discovery": "^1.20",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpunit/phpunit": "^11.5",
        "psr/http-server-middleware": "^1.0",
        "rector/rector": "^2.0",
        "symfony/http-client": "^7.4 || ^8.0",
        "symfony/http-foundation": "^7.4 || ^8.0"
    },
    "conflict": {
        "symfony/http-client": "<6.2"
    },
    "suggest": {
        "symfony/http-client": "Recommended HTTP client: per-request timeout and max_duration, optional non-blocking sends (async option)",
        "guzzlehttp/guzzle": "PSR-18 client auto-configured with the timeout option",
        "php-http/discovery": "Find any installed PSR-18 client and PSR-17 factories",
        "monolog/monolog": "Forward log records with Nowo\\Beacon\\Monolog\\BeaconHandler (Monolog 2 or 3)",
        "psr/http-server-middleware": "Nowo\\Beacon\\Http\\BeaconMiddleware for PSR-15 stacks (Slim, Mezzio)"
    },
    "autoload": {
        "psr-4": {
            "Nowo\\Beacon\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Nowo\\Beacon\\Tests\\": "tests/"
        }
    },
    "archive": {
        "exclude": [
            "/tests",
            "/.github",
            "/.scripts",
            "/.githooks",
            "/coverage",
            "/coverage.xml",
            "/Dockerfile",
            "/docker-compose.yml"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": false
        },
        "platform": {
            "php": "8.2.0"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    },
    "scripts": {
        "test": "phpunit --colors=always",
        "test-coverage": "phpunit --colors=always --coverage-html coverage --coverage-clover coverage.xml --coverage-text",
        "cs-check": "php-cs-fixer fix --dry-run --diff --config=.php-cs-fixer.dist.php",
        "cs-fix": "php-cs-fixer fix --config=.php-cs-fixer.dist.php",
        "rector": "rector process",
        "rector-dry": "rector process --dry-run --no-progress-bar",
        "phpstan": "phpstan analyse --memory-limit=512M -c phpstan.neon.dist",
        "validate": "composer validate --strict",
        "qa": [
            "@cs-check",
            "@phpstan",
            "@test"
        ]
    },
    "scripts-descriptions": {
        "test": "Run PHPUnit tests",
        "test-coverage": "Run PHPUnit tests with code coverage",
        "cs-check": "Check code style with PHP-CS-Fixer",
        "cs-fix": "Fix code style with PHP-CS-Fixer",
        "rector": "Apply Rector refactoring",
        "rector-dry": "Run Rector in dry-run mode",
        "phpstan": "Run PHPStan static analysis (level max)",
        "validate": "Validate composer.json (composer validate --strict)",
        "qa": "Run all quality assurance checks"
    }
}
